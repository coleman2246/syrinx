# Copy to docker/.env and fill in. That file is gitignored: the token must not
# be committed.
#
# Compose reads it automatically for every subcommand, so `up`, `ps`, `logs`
# and `down` all work without exporting anything into the shell.

# Required. Generate with: openssl rand -hex 24
SYRINX_TOKEN=

# Where the model directory lives on the host. Mounted read-only at /models.
SYRINX_MODELS=/srv/syrinx/models

# Host interface and port to publish on. Every interface by default, because
# this is a LAN service. Narrow to 127.0.0.1:8770 on a machine that only ever
# talks to itself.
#SYRINX_LISTEN=0.0.0.0:8770
