<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Must match the keyboard's group exactly. The app writes transcript
         text into this container and the extension reads it out; a mismatch
         is silent, because each side simply gets its own private container. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.space.aragonite.SyrinxDemo</string>
    </array>
</dict>
</plist>
