<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The channel the keyboard reads transcript text from. Without this
         declared, a signer has nothing to grant and the shared container
         simply does not exist -- which looks identical to the entitlement
         being refused. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.space.aragonite.SyrinxDemo</string>
    </array>
</dict>
</plist>
